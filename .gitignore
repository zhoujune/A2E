# TLA+ Toolbox and TLC-generated state/trace artifacts
**/.toolbox/
**/states/
**/states-*/
**/MC*.tla
**/*_TTrace_*.tla
**/*.out

# Locally generated model-check reports; retain the versioned schema.
formal/results/*.json
!formal/results/schema.json
!formal/results/h1-full.result.json

# Retain the current Verus evidence and its versioned schema.
mechanized/results/*.json
!mechanized/results/verification-report.json
!mechanized/results/verification-report.schema.v1.json
!mechanized/results/verification-report-linux-*.json

# Standard Rust build output for the M4 reference broker.
**/target/

# Downloaded/generated manuscript template package.
paper/template/acmart-primary-2.19-source.zip

# Local related-work copies; cite the published sources instead.
paper/AgentBound.pdf
paper/reading/*.pdf

# Python validation-script caches.
**/__pycache__/
**/*.pyc

# Retain only the versioned Linux artifact preflight report.
artifact/results/*.json
!artifact/results/linux-smoke-preflight.json
!artifact/results/archive-smoke-preflight-*.json
!artifact/results/tla-*.json
