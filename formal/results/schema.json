{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProveAI TLA+ model-check result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "startedAtUtc",
    "completedAtUtc",
    "invocation",
    "manifest",
    "runner",
    "resultSchema",
    "snapshot",
    "toolSnapshot",
    "modelInputs",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": { "const": "1.3.0" },
    "runId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "status": { "enum": ["running", "passed", "failed"] },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "completedAtUtc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workingDirectory",
        "suite",
        "scenario",
        "workers",
        "coverage"
      ],
      "properties": {
        "workingDirectory": {
          "type": "string",
          "minLength": 1,
          "not": {
            "anyOf": [
              { "pattern": "^[A-Za-z]:[\\\\/]" },
              { "pattern": "^(?:/|\\\\\\\\)" }
            ]
          }
        },
        "suite": { "enum": ["smoke", "full", null] },
        "scenario": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "workers": { "type": "integer", "minimum": 1, "maximum": 32 },
        "coverage": { "type": "boolean" }
      }
    },
    "manifest": { "$ref": "#/$defs/hashedInput" },
    "runner": { "$ref": "#/$defs/hashedInput" },
    "resultSchema": { "$ref": "#/$defs/hashedInput" },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "createdAtUtc",
        "tlaFileCount",
        "configurationFileCount"
      ],
      "properties": {
        "kind": { "const": "isolated-read-only-copy" },
        "createdAtUtc": { "type": "string", "format": "date-time" },
        "tlaFileCount": { "type": "integer", "minimum": 1 },
        "configurationFileCount": { "type": "integer", "minimum": 1 }
      }
    },
    "toolSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "createdAtUtc",
        "fileCount",
        "directoryCount",
        "treeSha256",
        "jreArchive",
        "tlaTools",
        "java"
      ],
      "properties": {
        "kind": { "const": "isolated-per-run-copy" },
        "createdAtUtc": { "type": "string", "format": "date-time" },
        "fileCount": { "type": "integer", "minimum": 3 },
        "directoryCount": { "type": "integer", "minimum": 1 },
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "jreArchive": {
          "allOf": [
            { "$ref": "#/$defs/hashedInput" },
            { "properties": { "path": { "const": "jre.zip" } } }
          ]
        },
        "tlaTools": {
          "allOf": [
            { "$ref": "#/$defs/hashedInput" },
            { "properties": { "path": { "const": "tla2tools.jar" } } }
          ]
        },
        "java": {
          "allOf": [
            { "$ref": "#/$defs/hashedInput" },
            { "properties": { "path": { "const": "jre/bin/java.exe" } } }
          ]
        }
      }
    },
    "modelInputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hashedInput" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenarioResult" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "running" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "completedAtUtc": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "passed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "completedAtUtc": { "type": "string", "format": "date-time" },
          "scenarios": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": { "const": "passed" },
                "exitStatus": { "const": 0 },
                "error": { "type": "null" }
              },
              "required": ["status", "exitStatus", "error"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "failed" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "completedAtUtc": { "type": "string", "format": "date-time" }
        }
      }
    }
  ],
  "$defs": {
    "nullableInteger": {
      "type": ["integer", "null"]
    },
    "nullableNonnegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tier",
        "status",
        "startedAtUtc",
        "completedAtUtc",
        "durationMilliseconds",
        "exitStatus",
        "error",
        "workers",
        "coverage",
        "module",
        "configuration",
        "toolchain",
        "exploration",
        "statistics"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "tier": { "enum": ["smoke", "full"] },
        "status": { "enum": ["passed", "failed"] },
        "startedAtUtc": { "type": "string", "format": "date-time" },
        "completedAtUtc": { "type": "string", "format": "date-time" },
        "durationMilliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "exitStatus": { "$ref": "#/$defs/nullableInteger" },
        "error": { "type": ["string", "null"] },
        "workers": { "type": "integer", "minimum": 1, "maximum": 32 },
        "coverage": { "type": "boolean" },
        "module": { "$ref": "#/$defs/hashedInput" },
        "configuration": { "$ref": "#/$defs/hashedInput" },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tlaToolsVersion",
            "tlaToolsSha256",
            "observedTlcVersion",
            "jreVersion",
            "jreSha256",
            "javaSha256",
            "observedJavaVersion"
          ],
          "properties": {
            "tlaToolsVersion": { "type": "string", "minLength": 1 },
            "tlaToolsSha256": { "$ref": "#/$defs/sha256" },
            "observedTlcVersion": { "type": ["string", "null"] },
            "jreVersion": { "type": "string", "minLength": 1 },
            "jreSha256": { "$ref": "#/$defs/sha256" },
            "javaSha256": { "$ref": "#/$defs/sha256" },
            "observedJavaVersion": { "type": "string", "minLength": 1 }
          }
        },
        "exploration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fingerprintIndex", "seed", "aril"],
          "properties": {
            "fingerprintIndex": { "$ref": "#/$defs/nullableInteger" },
            "seed": { "$ref": "#/$defs/nullableInteger" },
            "aril": { "$ref": "#/$defs/nullableInteger" }
          }
        },
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generatedStates", "distinctStates", "depth"],
          "properties": {
            "generatedStates": {
              "$ref": "#/$defs/nullableNonnegativeInteger"
            },
            "distinctStates": {
              "$ref": "#/$defs/nullableNonnegativeInteger"
            },
            "depth": { "$ref": "#/$defs/nullableNonnegativeInteger" }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "passed" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "exitStatus": { "const": 0 },
              "error": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "const": "failed" } },
            "required": ["status"]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "error": { "type": "string", "minLength": 1 }
                },
                "required": ["error"]
              },
              {
                "properties": {
                  "exitStatus": {
                    "type": "integer",
                    "not": { "const": 0 }
                  }
                },
                "required": ["exitStatus"]
              }
            ]
          }
        }
      ]
    }
  }
}
