{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProveAI TLA+ model-check result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "startedAtUtc",
    "completedAtUtc",
    "invocation",
    "manifest",
    "runner",
    "resultSchema",
    "modelInputs",
    "scenarios"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "runId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "status": { "enum": ["running", "passed", "failed"] },
    "startedAtUtc": { "type": "string", "format": "date-time" },
    "completedAtUtc": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workingDirectory",
        "suite",
        "scenario",
        "workers",
        "coverage"
      ],
      "properties": {
        "workingDirectory": { "type": "string", "minLength": 1 },
        "suite": { "type": ["string", "null"] },
        "scenario": { "type": ["string", "null"] },
        "workers": { "type": "integer", "minimum": 1, "maximum": 32 },
        "coverage": { "type": "boolean" }
      }
    },
    "manifest": { "$ref": "#/$defs/hashedInput" },
    "runner": { "$ref": "#/$defs/hashedInput" },
    "resultSchema": { "$ref": "#/$defs/hashedInput" },
    "modelInputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hashedInput" }
    },
    "scenarios": {
      "type": "array",
      "items": { "$ref": "#/$defs/scenarioResult" }
    }
  },
  "$defs": {
    "nullableInteger": {
      "type": ["integer", "null"]
    },
    "nullableNonnegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hashedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tier",
        "status",
        "startedAtUtc",
        "completedAtUtc",
        "durationMilliseconds",
        "exitStatus",
        "error",
        "workers",
        "coverage",
        "module",
        "configuration",
        "toolchain",
        "exploration",
        "statistics"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "startedAtUtc": { "type": "string", "format": "date-time" },
        "completedAtUtc": { "type": "string", "format": "date-time" },
        "durationMilliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "exitStatus": { "$ref": "#/$defs/nullableInteger" },
        "error": { "type": ["string", "null"] },
        "workers": { "type": "integer", "minimum": 1, "maximum": 32 },
        "coverage": { "type": "boolean" },
        "module": { "$ref": "#/$defs/hashedInput" },
        "configuration": { "$ref": "#/$defs/hashedInput" },
        "toolchain": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tlaToolsVersion",
            "tlaToolsSha256",
            "observedTlcVersion",
            "jreVersion",
            "jreSha256",
            "observedJavaVersion"
          ],
          "properties": {
            "tlaToolsVersion": { "type": "string", "minLength": 1 },
            "tlaToolsSha256": { "$ref": "#/$defs/sha256" },
            "observedTlcVersion": { "type": ["string", "null"] },
            "jreVersion": { "type": "string", "minLength": 1 },
            "jreSha256": { "$ref": "#/$defs/sha256" },
            "observedJavaVersion": { "type": "string", "minLength": 1 }
          }
        },
        "exploration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fingerprintIndex", "seed", "aril"],
          "properties": {
            "fingerprintIndex": { "$ref": "#/$defs/nullableInteger" },
            "seed": { "$ref": "#/$defs/nullableInteger" },
            "aril": { "$ref": "#/$defs/nullableInteger" }
          }
        },
        "statistics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["generatedStates", "distinctStates", "depth"],
          "properties": {
            "generatedStates": {
              "$ref": "#/$defs/nullableNonnegativeInteger"
            },
            "distinctStates": {
              "$ref": "#/$defs/nullableNonnegativeInteger"
            },
            "depth": { "$ref": "#/$defs/nullableNonnegativeInteger" }
          }
        }
      }
    }
  }
}
